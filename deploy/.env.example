# Copy to deploy/.env and fill in strong secrets before running: docker compose up -d --build
POSTGRES_USER=hermes
POSTGRES_PASSWORD=replace_with_strong_postgres_password
POSTGRES_DB=hermes

HERMES_PORT=5258
HERMES_SERVER_NAME=Hermes Media Server
HERMES_JWT_SECRET=replace_with_at_least_32_random_characters_for_jwt
HERMES_STREAM_TICKET_SECRET=replace_with_at_least_32_random_characters_for_tickets
HERMES_TMDB_API_KEY=

# Read-only mount path to your host media root (add libraries from the Admin UI after setup)
HERMES_MEDIA_PATH=/path/to/your/media
