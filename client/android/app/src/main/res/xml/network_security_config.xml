<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Self-hosted LAN/Tailscale IPv4 servers (e.g. 192.168.x.x) cannot be matched via Android domain-config wildcards. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <debug-overrides>
        <trust-anchors>
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
