{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Hermes.Api (.NET 10 - Local Dev)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-backend",
      "program": "${workspaceFolder}/backend/src/Hermes.Api/bin/Debug/net10.0/Hermes.Api.dll",
      "args": [],
      "cwd": "${workspaceFolder}/backend/src/Hermes.Api",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5258",
        "Hermes__ServerName": "Hermes Media Server (Local Dev)"
      }
    },
    {
      "name": "Hermes Client (Flutter Web - Edge)",
      "type": "dart",
      "request": "launch",
      "cwd": "${workspaceFolder}/client",
      "program": "lib/main.dart",
      "args": [
        "-d",
        "edge"
      ]
    },
    {
      "name": "Hermes Client (Flutter Windows Desktop)",
      "type": "dart",
      "request": "launch",
      "cwd": "${workspaceFolder}/client",
      "program": "lib/main.dart",
      "args": [
        "-d",
        "windows"
      ]
    }
  ],
  "compounds": [
    {
      "name": "Hermes Full Stack (API + Web Client)",
      "configurations": [
        "Hermes.Api (.NET 10 - Local Dev)",
        "Hermes Client (Flutter Web - Edge)"
      ],
      "stopAll": true
    }
  ]
}
