{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-backend",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/backend/Hermes.slnx",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary;ForceNoAlign"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "test-backend",
      "command": "dotnet",
      "type": "process",
      "args": [
        "test",
        "${workspaceFolder}/backend/Hermes.slnx",
        "--configuration",
        "Release"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "docker-compose-up",
      "command": "docker",
      "type": "shell",
      "args": [
        "compose",
        "--env-file",
        "deploy/.env",
        "-f",
        "deploy/docker-compose.yml",
        "up",
        "-d",
        "--build"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "test-client",
      "command": "flutter",
      "type": "shell",
      "args": [
        "test",
        "--coverage"
      ],
      "options": {
        "cwd": "${workspaceFolder}/client"
      }
    }
  ]
}
